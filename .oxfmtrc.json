{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "useTabs": false,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 90,
  "tabWidth": 2,
  "ignorePatterns": [
    ".output/",
    ".wxt/",
    "web-ext-artifacts/",
    "public/",
    "package-lock.json",
    "**/*.md"
  ]
}
